{
    "version": 2,
    "regions": [
        "sin1"
    ],
    "framework": null,
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "memory": 1024,
            "maxDuration": 30,
            "excludeFiles": "{.vscode/**,docs/**,scratch/**,tests/**,dist/**,node_modules/**}"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/favicon.png",
            "dest": "/assets/img/favicon.png"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "VERCEL": "1",
        "APP_NAME": "SPKTAD Pelindo Cirebon",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
